---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import RecordRow from '../components/RecordRow.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { capabilities, faqs } from '../data/site';
import { breadcrumbNode, serviceNode, webPageNode } from '../lib/schema';

const description =
	'Work with Sandip Gangakhedkar: AI systems designed and shipped, fractional CTO and CPO leadership for founders, technical due diligence, and speaking. London-based, working with teams worldwide.';

const seo = {
	title: 'Work with me: AI systems, fractional CTO and CPO',
	description,
	schema: [
		webPageNode({ path: '/services/', name: 'Work with me', description }),
		serviceNode(),
		breadcrumbNode([{ name: 'Services', path: '/services/' }]),
	],
};
---

<Base seo={seo}>
	<Section id="intro" num="01" title="Work with me." as="h1">
		<div class="opener">
			<p class="lede">
				I partner with founders and leadership teams to close the gap between business strategy and execution.
			</p>
			<div class="copy">
				<p>
					Depending on the situation, I step in to fix an immediate problem or work alongside your team to build lasting
					capability. 
				</p>
			</div>
			<nav class="actions" aria-label="On this page">
				<a class="link" href="#founders">Founders and scale-ups<Icon name="down" /></a>
				<a class="link" href="#ai">Companies adopting AI<Icon name="down" /></a>
				<a class="link" href="#due-diligence">Due diligence<Icon name="down" /></a>
				<a class="link" href="#speaking">Speaking and press<Icon name="down" /></a>
			</nav>
		</div>
	</Section>

	<Section id="founders" num="02" title="Founders and scale-ups.">
		<div class="stack-lg">
			<p class="copy">
				Fractional CTO and CPO work for companies that need senior technology and product leadership from someone who
				stays hands-on.
			</p>
			<ul class="rows rows--compact">
				{capabilities.founders.map((item) => <RecordRow item={item} />)}
			</ul>
			<div class="actions">
				<a class="btn" href="/contact/?topic=founder">Enquire as a founder<Icon name="right" /></a>
			</div>
		</div>
	</Section>

	<Section id="ai" num="03" title="Companies adopting AI.">
		<div class="stack-lg">
			<p class="copy">
				For businesses that need an AI system designed, evaluated and shipped, not a strategy deck.
			</p>
			<ul class="rows rows--compact">
				{capabilities.ai.map((item) => <RecordRow item={item} />)}
			</ul>
			<div class="actions">
				<a class="btn" href="/contact/?topic=ai">Talk about an AI system<Icon name="right" /></a>
			</div>
		</div>
	</Section>

	<Section id="due-diligence" num="04" title="Technical due diligence.">
		<div class="stack-lg">
			<div class="copy">
				<p>
					Technology assessments that support fundraising and M&amp;A: architecture, code quality, team capability and
					technical risk.
				</p>
				<p>
					For founders preparing to raise, it means walking into investor conversations with a clear, honest account of
					the technology and a roadmap that lines up with business milestones.
				</p>
			</div>
			<div class="actions">
				<a class="link" href="/contact/?topic=founder">Ask about due diligence<Icon name="right" /></a>
			</div>
		</div>
	</Section>

	<Section id="speaking" num="05" title="Speaking and press.">
		<div class="stack-lg">
			<p class="copy">
				Talks, panels, podcasts and interviews. These are the subjects I can speak to from first-hand experience.
			</p>
			<ul class="rows rows--compact">
				{capabilities.speaking.map((item) => <RecordRow item={item} />)}
			</ul>
			<div class="actions">
				<a class="btn" href="/contact/?topic=speaking">Send a speaking or press request<Icon name="right" /></a>
			</div>
		</div>
	</Section>

	<!-- <Section id="experience" num="06" title="First-hand experience.">
		<ul class="rows rows--compact">
			{capabilities.experience.map((item) => <RecordRow item={item} />)}
		</ul>
	</Section> -->

	<!-- <Section id="faq" num="07" title="Questions.">
		<div class="faq">
			{
				faqs.map((faq) => (
					<details>
						<summary>
							<span>{faq.question}</span>
							<Icon name="plus" />
						</summary>
						<p class="faq__a">{faq.answer}</p>
					</details>
				))
			}
		</div>
	</Section> -->

	<Section id="contact" num="06" title="Get in touch.">
		<div class="stack-lg">
			<p class="copy">Tell me what you're building and where you could use help. A couple of paragraphs is enough.</p>
			<EnquiryForm idPrefix="services" />
		</div>
	</Section>
</Base>
