---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PostList from '../components/PostList.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { site, now, homeSections as s } from '../data/site';
import { getPosts } from '../lib/posts';
import { webPageNode } from '../lib/schema';

const posts = (await getPosts()).slice(0, 4);

const seo = {
	description: site.description,
	schema: [webPageNode({ path: '/', name: site.title, description: site.description })],
};
---

<Base seo={seo}>
	<Section {...s.intro} as="h1">
		<div class="opener">
			<p class="lede">{site.lede}</p>
			<p class="status">
				<span class="status__label"><span class="led led--live" aria-hidden="true"></span>{now.label}</span>
				<span>{now.text}</span>
			</p>
			<div class="actions">
				<a class="btn" href="#contact">Start an enquiry<Icon name="down" /></a>
				<a class="link" href="/projects/">See the projects<Icon name="right" /></a>
			</div>
		</div>
	</Section>

	<Section {...s.work}>
		<div class="stack-lg">
			<div class="copy">
				<p>
					I enjoy working with sharp, driven people on thorny problems at the intersection of technology and business. I like to work directly with founders & leadership teams on focused, high impact projects.
				</p>
			</div>
			{/* Ways to work together rows: hidden for now. To restore, uncomment and re-import RecordRow and doors.
			<ul class="rows">
				{doors.map((item) => <RecordRow item={item} />)}
			</ul>
			*/}
		</div>
	</Section>

	<Section {...s.writing}>
		<div class="stack-lg">
			<p class="copy">{site.blogDescription}</p>
			<PostList posts={posts} />
			<div class="actions">
				<a class="link" href="/writing/">All writing<Icon name="right" /></a>
				<a class="link" href="/writing/rss.xml">RSS feed<Icon name="up-right" /></a>
			</div>
		</div>
	</Section>

	<Section {...s.contact}>
		<div class="stack-lg">
			<p class="copy">Tell me what you're building and where you could use help. A couple of paragraphs is enough.</p>
			<EnquiryForm idPrefix="home" />
		</div>
	</Section>
</Base>
