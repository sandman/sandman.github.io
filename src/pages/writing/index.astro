---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import PostList from '../../components/PostList.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { collectTags, getPosts, groupByYear, isAged } from '../../lib/posts';
import { blogNode, breadcrumbNode, webPageNode } from '../../lib/schema';

const posts = await getPosts();
const years = groupByYear(posts);
const tags = collectTags(posts);
const pad = (value: number) => String(value).padStart(2, '0');

const description = `${site.blogName}: writing by ${site.name} on startups, technology, product development and building AI systems.`;

const seo = {
	title: site.blogName,
	description,
	schema: [
		webPageNode({ path: '/writing/', name: site.blogName, description, type: 'CollectionPage' }),
		blogNode(posts),
		breadcrumbNode([{ name: 'Writing', path: '/writing/' }]),
	],
};
---

<Base seo={seo}>
	<Section id="intro" num="01" title={`${site.blogName}.`} as="h1">
		<div class="opener">
			<p class="lede">{site.blogDescription}</p>
			<div class="actions">
				<a class="link" href="#topics">Browse by topic<Icon name="down" /></a>
				<a class="link" href="/writing/rss.xml">RSS feed<Icon name="up-right" /></a>
			</div>
		</div>
	</Section>

	{
		years.map((group, index) => {
			const aged = group.posts.every((post) => isAged(post.data.publishDate));
			return (
				<Section id={`y${group.year}`} num={pad(index + 2)} title={`${group.year}.`}>
					<div class="stack">
						{aged && (
							<p class="aged">
								<span class="hatch" aria-hidden="true" />
								<span>Written in {group.year}. Some details may have aged since.</span>
							</p>
						)}
						<PostList posts={group.posts} descriptions />
					</div>
				</Section>
			);
		})
	}

	<Section id="topics" num={pad(years.length + 2)} title="Topics.">
		<ul class="tags">
			{
				tags.map((tag) => (
					<li>
						<a class="tag" href={`/writing/tags/${tag.slug}/`}>
							{tag.name}
							<span class="tag__count">{tag.count}</span>
						</a>
					</li>
				))
			}
		</ul>
	</Section>
</Base>
