---
import Base from '../../../layouts/Base.astro';
import Section from '../../../components/Section.astro';
import PostList from '../../../components/PostList.astro';
import Icon from '../../../components/Icon.astro';
import { site } from '../../../data/site';
import { collectTags, getPosts, slugify, type Post, type TagSummary } from '../../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return collectTags(posts).map((tag) => ({
		params: { slug: tag.slug },
		props: {
			tag,
			posts: posts.filter((post) => post.data.tags.some((name) => slugify(name) === tag.slug)),
		},
	}));
}

interface Props {
	tag: TagSummary;
	posts: Post[];
}

const { tag, posts } = Astro.props;

const seo = {
	title: `${tag.name} | ${site.blogName}`,
	description: `Writing by ${site.name} tagged ${tag.name}.`,
	noindex: true,
};
---

<Base seo={seo}>
	<Section id="intro" num="01" title={`${tag.name}.`} as="h1">
		<div class="stack-lg">
			<p class="lede">
				{tag.count}
				{tag.count === 1 ? 'note' : 'notes'} from {site.blogName} tagged {tag.name}.
			</p>
			<PostList posts={posts} descriptions />
			<div class="actions">
				<a class="link" href="/writing/tags/">All topics<Icon name="right" /></a>
				<a class="link" href="/writing/">All writing<Icon name="right" /></a>
			</div>
		</div>
	</Section>
</Base>
