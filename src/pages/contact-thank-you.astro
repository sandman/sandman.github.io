---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';

const seo = {
	title: 'Message sent',
	description: 'Your message to Sandip Gangakhedkar has been sent.',
	noindex: true,
};
---

<Base seo={seo}>
	<Section id="sent" num="01" title="Message sent." as="h1">
		<div class="opener">
			<p class="status">
				<span class="status__label"><span class="led" aria-hidden="true"></span>Received</span>
				<span>Thanks for writing. I'll get back to you as soon as possible.</span>
			</p>
			<div class="actions">
				<a class="btn" href="/writing/">Read the writing<Icon name="right" /></a>
				<a class="link" href="/">Back to the home page<Icon name="right" /></a>
			</div>
		</div>
	</Section>
</Base>
