---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import RecordRow from '../components/RecordRow.astro';
import References from '../components/References.astro';
import Icon from '../components/Icon.astro';
import { record, recordGroups } from '../data/site';
import { breadcrumbNode, webPageNode } from '../lib/schema';

const description =
	"Projects by Sandip Gangakhedkar: a new venture in AI and institutional finance, Imperium Drive and Fetch, fractional CTO and CPO work, Meshh, and a decade of research at Bell Labs, Nokia and Huawei Research.";

const groups = recordGroups
	.map((group) => ({ ...group, items: record.filter((item) => item.group === group.id) }))
	.filter((group) => group.items.length > 0);

const cited = [...new Set(record.flatMap((item) => item.cites ?? []))];
const pad = (value: number) => String(value).padStart(2, '0');

const seo = {
	title: 'Projects',
	description,
	schema: [
		webPageNode({ path: '/projects/', name: 'Projects', description, type: 'CollectionPage' }),
		breadcrumbNode([{ name: 'Projects', path: '/projects/' }]),
	],
};
---

<Base seo={seo}>
	<Section id="intro" num="01" title="Projects." as="h1">
		<div class="opener">
			<p class="lede">What I've built.</p>
			<div class="actions">
				<a class="btn" href="/contact/">Get in touch<Icon name="right" /></a>
				<a class="link" href="#references">Sources<Icon name="down" /></a>
			</div>
		</div>
	</Section>

	{
		groups.map((group, index) => (
			<Section id={group.id} num={pad(index + 2)} title={group.title}>
				<ul class="rows">
					{group.items.map((item) => (
						<RecordRow item={item} />
					))}
				</ul>
			</Section>
		))
	}

	<Section id="references" num={pad(groups.length + 2)} title="References.">
		<References only={cited} />
	</Section>
</Base>
