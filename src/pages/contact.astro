---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, socials } from '../data/site';
import { breadcrumbNode, webPageNode } from '../lib/schema';

const description =
	'Contact Sandip Gangakhedkar about an AI system, fractional CTO or CPO leadership, technical due diligence, or a speaking or press request.';

const direct = socials.filter((social) => ['LinkedIn', 'X (Twitter)'].includes(social.label));

const seo = {
	title: 'Get in touch',
	description,
	schema: [
		webPageNode({ path: '/contact/', name: 'Get in touch', description, type: 'ContactPage' }),
		breadcrumbNode([{ name: 'Contact', path: '/contact/' }]),
	],
};
---

<Base seo={seo}>
	<Section id="intro" num="01" title="Get in touch." as="h1">
		<div class="split">
			<div class="stack-lg">
				<div class="copy">
					<p class="lede">Tell me what you're building and where you could use help.</p>
					<p>A couple of paragraphs is enough. You're also welcome to send a link, ask a question, or just say hello.</p>
				</div>
				<EnquiryForm idPrefix="contact" />
			</div>
			<dl class="aside">
				<div class="aside__row">
					<dt>Based in</dt>
					<dd>{site.locality}, {site.countryName}.</dd>
				</div>
				<div class="aside__row">
					<dt>Elsewhere</dt>
					<dd>
						{direct.map((social, index) => (
							<Fragment>{index > 0 ? ', ' : ''}<a href={social.href} rel="me noopener">{social.label}</a></Fragment>
						))}
					</dd>
				</div>
			</dl>
		</div>
	</Section>
</Base>
