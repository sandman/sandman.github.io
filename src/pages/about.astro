---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import RecordRow from '../components/RecordRow.astro';
import References from '../components/References.astro';
import Cite from '../components/Cite.astro';
import Icon from '../components/Icon.astro';
import { site, socials } from '../data/site';
import { breadcrumbNode, profilePageNode } from '../lib/schema';

const description =
	'About Sandip Gangakhedkar: London-based technologist, AI systems builder and founder. A decade of research at Bell Labs, Nokia and Huawei with 20+ patents, then co-founder of Imperium Drive and Fetch.';

// Show a readable host and path; drop query strings such as Google Scholar's.
const linkLabel = (href: string) => {
	const url = new URL(href);
	const host = url.host.replace(/^www\./, '');
	return url.search ? host : `${host}${url.pathname}`.replace(/\/$/, '');
};

const elsewhere = socials.map((social) => ({
	id: social.label.toLowerCase().replace(/[^a-z]+/g, '-'),
	title: social.label,
	body: social.note,
	link: { href: social.href, label: linkLabel(social.href) },
}));

const seo = {
	title: 'About',
	description,
	type: 'profile' as const,
	schema: [
		profilePageNode({ path: '/about/', name: `About ${site.name}`, description }),
		breadcrumbNode([{ name: 'About', path: '/about/' }]),
	],
};
---

<Base seo={seo}>
	<Section id="intro" num="01" title="Hi, I'm Sandip." as="h1">
		<div class="split">
			<div class="opener">
				<p class="lede">
					I enjoy taking calculated risks, solving impactful problems and working with ambitious, driven people. 				</p>
				<blockquote class="quote">
					<p>One thing I've learned: you can know anything. It's all there, you just have to find it.</p>
				</blockquote>
				<div class="actions">
					<a class="btn" href="/contact/">Get in touch<Icon name="right" /></a>
					<a class="link" href="/projects/">See the projects<Icon name="right" /></a>
				</div>
			</div>
			<figure class="portrait">
				<img
					src={site.portrait}
					width="800"
					height="800"
					alt="Portrait of Sandip Gangakhedkar in a light linen shirt"
					decoding="async"
					fetchpriority="high"
				/>
				<figcaption>{site.name}</figcaption>
			</figure>
		</div>
	</Section>

