---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import { nav } from '../data/site';

const seo = {
	title: 'Page not found',
	description: 'There is nothing at this address on sandip.live.',
	noindex: true,
};
---

<Base seo={seo}>
	<Section id="not-found" num="404" title="Nothing at this address." as="h1">
		<div class="opener">
			<p class="lede">The page may have moved when the site was redesigned. Try one of these instead.</p>
			<nav class="actions" aria-label="Main sections">
				<a class="btn" href="/">Home<Icon name="right" /></a>
				{
					nav.map((item) => (
						<a class="link" href={item.href}>
							{item.label}
							<Icon name="right" />
						</a>
					))
				}
			</nav>
		</div>
	</Section>
</Base>
