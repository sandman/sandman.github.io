---
import settings from '../../config/settings.js';

interface Props {
  items: Array<{
    name: string;
    url?: string;
  }>;
}

const { items } = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": settings.url
    },
    ...items.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 2,
      "name": item.name,
      ...(item.url ? { "item": `${settings.url}${item.url}` } : {})
    }))
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
