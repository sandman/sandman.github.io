---
import settings from '../../config/settings.js';

const services = [
  {
    "@type": "Service",
    "name": "Fractional CTO Services",
    "description": "Part-time Chief Technology Officer services for startups and growth companies. Includes technology strategy, architecture decisions, team building, and technical due diligence.",
    "provider": {
      "@type": "Person",
      "name": settings.name,
      "url": settings.url
    },
    "serviceType": "Technology Consulting",
    "areaServed": {
      "@type": "Place",
      "name": "Global"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Fractional CTO Engagement Options",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Strategic Advisory",
            "description": "Monthly strategy sessions, roadmap reviews, and on-demand consultation for critical decisions. A few hours per month."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Tactical Leadership",
            "description": "Hands-on team management, product development, and operational improvements. 20-30 hours per month."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Executive Partnership",
            "description": "Comprehensive technology leadership including strategic planning, team leadership, and investor relations. 2-3 days per week."
          }
        }
      ]
    }
  },
  {
    "@type": "Service",
    "name": "Fractional CPO Services",
    "description": "Part-time Chief Product Officer services focusing on product strategy, roadmap development, product-market fit validation, and user experience optimization.",
    "provider": {
      "@type": "Person",
      "name": settings.name,
      "url": settings.url
    },
    "serviceType": "Product Leadership",
    "areaServed": {
      "@type": "Place",
      "name": "Global"
    }
  },
  {
    "@type": "Service",
    "name": "Technology Strategy & Roadmap",
    "description": "Align technology initiatives with business goals and market opportunities. Define technical vision and execution roadmap.",
    "provider": {
      "@type": "Person",
      "name": settings.name,
      "url": settings.url
    },
    "serviceType": "Strategic Consulting"
  },
  {
    "@type": "Service",
    "name": "Technical Due Diligence",
    "description": "Comprehensive technology assessments to support fundraising rounds and M&A activities. Evaluate architecture, code quality, team capabilities, and technical risks.",
    "provider": {
      "@type": "Person",
      "name": settings.name,
      "url": settings.url
    },
    "serviceType": "Due Diligence"
  },
  {
    "@type": "Service",
    "name": "Team Scaling & Building",
    "description": "Hire, onboard, and structure high-performing engineering and product teams. Implement effective processes and foster a culture of innovation.",
    "provider": {
      "@type": "Person",
      "name": settings.name,
      "url": settings.url
    },
    "serviceType": "Team Development"
  },
  {
    "@type": "Service",
    "name": "AI & Machine Learning Strategy",
    "description": "Strategic guidance on AI-native product development, agentic AI workflows, AI solution architectures, and evaluation systems.",
    "provider": {
      "@type": "Person",
      "name": settings.name,
      "url": settings.url
    },
    "serviceType": "AI Consulting"
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": services.map(service => ({
    ...service,
    "@context": undefined
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
