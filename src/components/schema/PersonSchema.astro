---
import settings from '../../config/settings.js';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": settings.name,
  "url": settings.url,
  "jobTitle": "Fractional CTO & CPO",
  "description": settings.description,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "London",
    "addressCountry": "UK"
  },
  "knowsAbout": [
    "Fractional CTO Services",
    "Fractional CPO Services",
    "Technology Leadership",
    "Product Management",
    "Startup Consulting",
    "Software Architecture",
    "Team Scaling",
    "Technical Strategy",
    "Product Development",
    "Technical Due Diligence",
    "AI and Machine Learning",
    "Agentic AI Systems",
    "Autonomous Systems",
    "IoT and Robotics",
    "B2B SaaS",
    "Agile Methodologies",
    "DevOps",
    "5G Networks"
  ],
  "alumniOf": [
    {
      "@type": "Organization",
      "name": "Bell Labs"
    },
    {
      "@type": "Organization",
      "name": "Huawei"
    },
    {
      "@type": "Organization",
      "name": "Nokia"
    }
  ],
  "worksFor": {
    "@type": "Organization",
    "name": "Meshh",
    "description": "Spatial analytics company"
  },
  "founder": {
    "@type": "Organization",
    "name": "Imperium Drive",
    "description": "Autonomous driving and tele-operated vehicles"
  },
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "patent",
      "description": "20+ patents in communications and network protocols"
    }
  ],
  "sameAs": [
    "https://linkedin.com/in/sandipgangakhedkar",
    "https://twitter.com/sandipgh"
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>