---
import { site, socials } from '../data/site';
import { personNode, websiteNode } from '../lib/schema';

export interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article' | 'profile';
	published?: Date;
	modified?: Date;
	tags?: string[];
	noindex?: boolean;
	schema?: Record<string, unknown>[];
}

const {
	title,
	description = site.description,
	image = site.image,
	imageAlt = `${site.name}: ${site.headline}`,
	type = 'website',
	published,
	modified,
	tags = [],
	noindex = false,
	schema = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.title;
const socialTitle = title ?? site.title;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const imageUrl = new URL(image, site.url).toString();
const graph = {
	'@context': 'https://schema.org',
	'@graph': [personNode(), websiteNode(), ...schema],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta
	name="robots"
	content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<meta name="author" content={site.name} />
<meta name="theme-color" content="#f8f9fa" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.png" type="image/png" sizes="180x180" />
<link rel="apple-touch-icon" href="/favicon.png" />
<link rel="alternate" type="application/rss+xml" title={`${site.blogName} by ${site.name}`} href="/writing/rss.xml" />
<link rel="sitemap" href="/sitemap.xml" />
<link rel="author" href="/about/" />
{socials.map((social) => <link rel="me" href={social.href} />)}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
{type === 'article' && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{type === 'article' && <meta property="article:author" content={new URL('/about/', site.url).toString()} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitter} />
<meta name="twitter:creator" content={site.twitter} />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
